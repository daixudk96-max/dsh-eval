{
  "name": "dsh-eval-console",
  "description": "Evolution console for the DSH Web GUI: a conversation.view tab (order 20) rendering a six-state board (SEALED/EVALUATING/ACCEPTED/PROMOTED/REJECTED/INCONCLUSIVE), a current-version bar and a JSONL audit timeline, backed by the real preset-registry and evolution-audit ledger over the Host webServer channel (GET /eval/state, POST /eval/action, GET /eval/events SSE).",
  "version": "0.1.0-rc.8",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "client-ui",
    "evolution",
    "preset-registry",
    "eval"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node smoke/smoke-state.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3"
  }
}
